// Prisma schema. Docs: https://pris.ly/d/prisma-schema
// Connection URLs live in prisma7.config.ts (CLI) and src/database/prisma.service.ts (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// An anonymous device; id is generated by the app (no auth).
model User {
  id        String    @id
  createdAt DateTime  @default(now()) @map("created_at")
  profile   Profile?
  mealLogs  MealLog[]

  @@map("users")
}

model Profile {
  userId         String   @id @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  goal           String // lose | maintain | gain
  sex            String // male | female | unspecified
  age            Int
  heightCm       Float    @map("height_cm")
  weightKg       Float    @map("weight_kg")
  targetWeightKg Float?   @map("target_weight_kg")
  activity       String // sedentary | light | moderate | very
  diet           String // veg | egg | nonveg | vegan
  heightUnit     String   @map("height_unit")
  weightUnit     String   @map("weight_unit")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model MealLog {
  id        String     @id
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local calendar day 'YYYY-MM-DD'; a string on purpose to avoid timezone shifts.
  date      String
  slot      String // breakfast | lunch | snacks | dinner
  rawText   String     @map("raw_text")
  /// App-side timestamps sent by the client (used for last-write-wins).
  createdAt DateTime   @map("created_at")
  updatedAt DateTime   @map("updated_at")
  items     MealItem[]

  @@index([userId, date])
  @@map("meal_logs")
}

model MealItem {
  id        String  @id
  mealLogId String  @map("meal_log_id")
  mealLog   MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  position  Int
  name      String
  quantity  Float
  unit      String
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float

  @@map("meal_items")
}
