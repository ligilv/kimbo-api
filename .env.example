# Supabase -> Project -> Connect.
# Runtime (the running server): Transaction pooler (Supavisor), port 6543.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (prisma migrate / studio): Direct connection, port 5432.
# (If your network has no IPv6, use the Session pooler URL on port 5432 instead.)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
GEMINI_API_KEY="your-gemini-api-key"
PORT=3000
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash"
